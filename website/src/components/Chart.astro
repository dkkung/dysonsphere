---
// Renders a dysonsphere Vega-Lite spec live and interactive via vega-embed.
// `name` maps to public/charts/<name>-light.json and <name>-dark.json (generated by
// scripts/gen_examples.py). The matching variant is shown for the site's theme and swapped
// live on toggle; the background is transparent so the page provides contrast.
interface Props {
	name: string;
	alt?: string;
	/** Apply the save()-time inward-ticks SVG fix for tickDirection="in" charts. */
	tickDirection?: 'in' | 'out';
	/** Auto-zoom the render to fill its container's width (for size-matched comparisons). */
	fitWidth?: boolean;
}
const { name, alt = 'dysonsphere chart', tickDirection = 'out', fitWidth = false } = Astro.props;
---

<figure class="ds-chart">
	<div
		class="ds-chart__view"
		data-chart={name}
		data-inward={tickDirection === 'in' ? '1' : undefined}
		data-fit={fitWidth ? '1' : undefined}
		role="img"
		aria-label={alt}
	>
	</div>
</figure>

<script>
	import { chartView, clearChart, embedChart } from '../lib/embedChart';
	import { fitChartToWidth, scaleChart, watchChartResolution } from '../lib/scaleChart';

	const BASE = import.meta.env.BASE_URL;
	const active = new Set<HTMLElement>();

	function fit(el: HTMLElement) {
		if (el.dataset.fit) {
			// The figure is independent of the embed's already-scaled content.
			fitChartToWidth(el, el.closest('figure')?.clientWidth ?? 0, chartView(el));
		} else scaleChart(el, undefined, chartView(el));
	}

	function renderOne(el: HTMLElement) {
		const name = el.dataset.chart;
		if (!name) return;
		active.add(el);
		const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
		void embedChart(el, async () => {
			const response = await fetch(`${BASE}charts/${name}-${theme}.json`);
			if (!response.ok) throw new Error(`Chart ${name}: ${response.status}`);
			const spec = await response.json();
			// Prefix root-relative image assets for project-pages deployments.
			const baseNoSlash = BASE.replace(/\/$/, '');
			const fixUrls = (o: unknown): void => {
				if (Array.isArray(o)) o.forEach(fixUrls);
				else if (o && typeof o === 'object') {
					const rec = o as Record<string, unknown>;
					if (typeof rec.url === 'string' && rec.url.startsWith('/') && !rec.url.startsWith(BASE)) {
						rec.url = baseNoSlash + rec.url;
					}
					Object.values(rec).forEach(fixUrls);
				}
			};
			fixUrls(spec);
			return spec;
		}, { actions: true, inward: Boolean(el.dataset.inward), afterRender: () => fit(el) }).catch((e) => {
			if (el.isConnected) el.textContent = 'Failed to load chart.';
			console.error(e);
		});
	}

	function renderAll() {
		document.querySelectorAll<HTMLElement>('.ds-chart__view[data-chart]').forEach(renderOne);
	}

	renderAll();
	document.addEventListener('astro:page-load', renderAll);
	document.addEventListener('astro:before-swap', () => {
		for (const el of active) clearChart(el);
		active.clear();
	});
	watchChartResolution(() => { for (const el of active) if (el.isConnected) fit(el); });
	new MutationObserver(renderAll).observe(document.documentElement, {
		attributes: true,
		attributeFilter: ['data-theme'],
	});
</script>

<style>
	.ds-chart {
		margin: 1.25rem 0;
	}
	.ds-chart__view {
		display: flex;
		justify-content: center;
		padding: 0.5rem 0;
		overflow: auto;
	}
</style>
